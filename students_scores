
scores = [45, 67, 52, 38, 81, 60, 49, 73, 55, 40]

average = sum(scores) / len(scores)

print("Student scores:", scores)
print("Average score:", average)
print("Highest score:", max(scores))
print("Lowest score:", min(scores))

passed = sum(1 for score in scores if score >= 50)
print("Students scoring 50 or above:", passed)

failed = sum(1 for score in scores if score < 50)
print("Students scoring below 50:", failed)

pass_rate = (passed / len(scores)) * 100
print("Pass rate:", pass_rate, "%")
for score in scores:
    if score >= 50:
        print(score, "- Pass")
    else:
        print(score, "- Fail")
if pass_rate >= 50:
    print("Class performance: More than half the students passed.")
else:
    print("Class performance: Fewer than half the students passed.")
